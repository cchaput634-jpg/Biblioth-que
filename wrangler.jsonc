{
  // Configuration Cloudflare Pages + D1.
  // Doc : https://developers.cloudflare.com/pages/functions/wrangler-configuration/
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "biblioth-que",
  "compatibility_date": "2025-06-01",

  // Format Pages : sert les assets Vite depuis ./dist, les fonctions
  // sont auto-découvertes dans functions/.
  "pages_build_output_dir": "./dist",

  // Base D1 — Pages lit ce binding automatiquement depuis wrangler.jsonc
  // (dès lors que pages_build_output_dir est présent).
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bibliotheque-db",
      "database_id": "b40d261b-b460-48c7-b31a-ba92fa5a6303"
    }
  ],

  // Variables d'environnement publiques (CLIENT_ID OAuth Discord est public).
  // Le CLIENT_SECRET est stocké en secret séparé via :
  //   npx wrangler pages secret put DISCORD_CLIENT_SECRET --project-name=biblioth-que
  "vars": {
    "DISCORD_CLIENT_ID": "1569011638957248562",
    "APP_URL": "https://biblioth-que.pages.dev"
  }
}
